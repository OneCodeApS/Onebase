# Normalize line endings. Without this, a Windows checkout (core.autocrlf=true)
# rewrites scripts to CRLF, and any script COPYed into a Linux image fails with
# "exec /entrypoint.sh: no such file or directory" because the shebang becomes
# "#!/bin/sh\r". Force LF on everything that runs in a container or shell.
* text=auto eol=lf

*.sh text eol=lf
entrypoint.sh text eol=lf
Dockerfile text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binaries: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
